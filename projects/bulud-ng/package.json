{
  "name": "bulud-ng",
  "version": "3.0.1",
  "peerDependencies": {
    "@angular/common": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tailwind.css": {
      "style": "./tailwind.css",
      "default": "./tailwind.css"
    },
    "./theme.css": {
      "style": "./theme.css",
      "default": "./theme.css"
    },
    "./angour.css": {
      "style": "./angour.css",
      "default": "./angour.css"
    },
    "./angour-base.css": {
      "style": "./angour-base.css",
      "default": "./angour-base.css"
    },
    "./line-chart.css": {
      "style": "./line-chart.css",
      "default": "./line-chart.css"
    },
    "./radial-chart.css": {
      "style": "./radial-chart.css",
      "default": "./radial-chart.css"
    },
    "./input-behaviors.css": {
      "style": "./input-behaviors.css",
      "default": "./input-behaviors.css"
    },
    "./account-card.css": {
      "style": "./account-card.css",
      "default": "./account-card.css"
    },
    "./language-switch.css": {
      "style": "./language-switch.css",
      "default": "./language-switch.css"
    }
  },
  "description": "Standalone Angular UI components, forms, charts and shared utilities with explicit Angour light/dark themes.",
  "keywords": [
    "angular",
    "components",
    "standalone",
    "rtl",
    "persian",
    "design-system"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepublishOnly": "node ./publish-check.mjs"
  },
  "license": "MIT",
  "author": {
    "name": "fatemehshirazmihan"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shayanblest/bulud-ng.git"
  },
  "homepage": "https://github.com/shayanblest/bulud-ng#readme",
  "bugs": {
    "url": "https://github.com/shayanblest/bulud-ng/issues"
  }
}
